{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Angelica Input Contract",
  "type": "object",
  "required": [
    "contract_version",
    "task_id",
    "orchestrator_trace_id",
    "mode",
    "goal",
    "user_context",
    "conversation_context",
    "input_payload"
  ],
  "properties": {
    "contract_version": { "type": "string" },
    "task_id": { "type": "string" },
    "orchestrator_trace_id": { "type": "string" },
    "mode": { "type": "string", "enum": ["plan_only", "execute"] },
    "goal": { "type": "string" },
    "user_context": { "type": "object" },
    "conversation_context": { "type": "object" },
    "constraints": { "type": "object" },
    "input_payload": { "type": "object" }
  },
  "additionalProperties": false
}
