{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Angelica Output Contract",
  "type": "object",
  "required": [
    "contract_version",
    "status",
    "confidence",
    "risk_level",
    "goal_result",
    "state_delta",
    "actions_executed",
    "user_reply",
    "artifacts",
    "audit_ref"
  ],
  "properties": {
    "contract_version": { "type": "string", "const": "1.1.0" },
    "status": { "type": "string", "enum": ["completed", "needs_input", "blocked", "failed"] },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "risk_level": { "type": "string", "enum": ["low", "medium", "high"] },
    "goal_result": { "type": "string" },
    "state_delta": {
      "type": "object",
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      },
      "additionalProperties": false
    },
    "actions_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tool", "ok"],
        "properties": {
          "tool": { "type": "string" },
          "ok": { "type": "boolean" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "user_reply": { "type": "string" },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id"],
        "properties": {
          "type": { "type": "string" },
          "id": { "type": "string" },
          "url": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "handoff_recommendation": {
      "type": ["object", "null"],
      "properties": {
        "target_agent_id": { "type": "string" },
        "reason": { "type": "string" },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "audit_ref": { "type": "string" }
  },
  "additionalProperties": false
}
